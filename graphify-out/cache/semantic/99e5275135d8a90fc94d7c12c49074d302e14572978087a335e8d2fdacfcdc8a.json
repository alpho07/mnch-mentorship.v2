{"nodes": [{"id": "assessment_analytics_dashboard_spec", "label": "Assessment Analytics Dashboard Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-11-assessment-analytics-dashboard-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds assessment mode as the first tab on the existing analytics dashboard so managers can see KPIs, charts, and a facilities readiness table with mentorship eligibility scoring without rebuilding the page."}, {"id": "assessment_analytics_service", "label": "AssessmentAnalyticsService", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-11-assessment-analytics-dashboard-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New service mirroring TrainingAnalyticsService; isolates all complex assessment analytics SQL so the controller stays thin."}, {"id": "feedback_tracking_migration", "label": "Add Feedback Tracking to Assessments Migration", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-11-assessment-analytics-dashboard-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds four feedback columns to assessments: feedback_given boolean, feedback_given_by FK, feedback_given_at timestamp, feedback_notes text."}, {"id": "skills_lab_derived_detection", "label": "Skills Lab Derived Detection", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-11-assessment-analytics-dashboard-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills lab presence is derived at query time from assessment_section_scores joined to the skills_lab section, avoiding schema drift between responses and a stored boolean."}, {"id": "mentorship_eligibility_logic"